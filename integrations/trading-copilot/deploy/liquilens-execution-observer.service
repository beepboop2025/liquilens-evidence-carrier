[Unit]
Description=LiquiLens source readiness observation without execution authority
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
User=liquilens-execution-observer
WorkingDirectory=/opt/liquilens-execution-observer/current
# Installer substitutes the qualified immutable source SHA and exact release path.
ExecStart=/opt/liquilens-execution-observer/current/integrations/trading-copilot/.venv/bin/python -B /opt/liquilens-execution-observer/current/integrations/trading-copilot/deploy/capture_observatory.py --state-dir /var/lib/liquilens-execution-observer --source-sha REPLACE_WITH_QUALIFIED_SOURCE_SHA
StateDirectory=liquilens-execution-observer
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
InaccessiblePaths=-/var/lib/liquilens-trading-copilot -/var/lib/liquilens-agent-host
ReadWritePaths=/var/lib/liquilens-execution-observer
TimeoutStartSec=60
MemoryMax=256M
TasksMax=32
