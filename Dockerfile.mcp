ARG BASE_IMAGE="ghcr.io/beepboop2025/liquilens-evidence-carrier@sha256:293a9ec61ad43f9bac22775936271b19651b486115ab53acbe7928cb177f8c4e"

FROM ${BASE_IMAGE}

ARG VERSION="0.18.0"
ARG BUILD_REVISION="906ca033a96ea862ab813c64db2a6b01c5ce8c4f"
ARG RELEASE_REVISION="906ca033a96ea862ab813c64db2a6b01c5ce8c4f"
ARG CREATED="2026-08-25T20:34:24Z"
ARG BASE_DIGEST="sha256:293a9ec61ad43f9bac22775936271b19651b486115ab53acbe7928cb177f8c4e"
ARG README_URL="https://raw.githubusercontent.com/beepboop2025/liquilens-evidence-carrier/afeb5ad9f7ab795a23882a9e714156c6aafd59c0/README.md"
ARG MAINTAINERS='[{"name":"LiquiLens maintainers","email":"beepboop2025@users.noreply.github.com"}]'

LABEL org.opencontainers.image.title="LiquiLens Evidence Carrier MCP" \
      org.opencontainers.image.description="Offline read-only MCP verification of local carriers and four-product fleet briefs." \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${BUILD_REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/beepboop2025/liquilens-evidence-carrier" \
      org.opencontainers.image.documentation="https://liquilens.in/protocol/" \
      org.opencontainers.image.url="https://liquilens.in/protocol/" \
      org.opencontainers.image.vendor="LiquiLens" \
      org.opencontainers.image.base.name="ghcr.io/beepboop2025/liquilens-evidence-carrier" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      io.liquilens.evidence.release.revision="${RELEASE_REVISION}" \
      io.artifacthub.package.readme-url="${README_URL}" \
      io.artifacthub.package.keywords="finance,evidence,provenance,mcp,offline,read-only" \
      io.artifacthub.package.license="Apache-2.0" \
      io.artifacthub.package.maintainers="${MAINTAINERS}" \
      io.artifacthub.package.category="integration-delivery"

ENTRYPOINT ["liquilens-evidence-mcp"]
CMD ["--root", "/evidence"]
