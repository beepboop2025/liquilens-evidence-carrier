        }
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "Spacing step 6 on a 4px base.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-space-6"
        }
      }
    },
    "7": {
      "$value": {
        "value": 32,
