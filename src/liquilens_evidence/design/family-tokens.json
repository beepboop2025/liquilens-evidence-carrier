      "$value": {
        "value": 3,
        "unit": "px"
      },
      "$description": "State chips and tags.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-radius-chip"
        }
      }
    },
    "control": {
      "$value": {
        "value": 5,
        "unit": "px"
      },
      "$description": "Buttons and form controls.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-radius-control"
        }
      }
    },
    "panel": {
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$description": "Panels, tables in a frame, the map frame.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-radius-panel"
        }
      }
    },
    "capsule": {
      "$value": {
        "value": 10,
        "unit": "px"
      },
      "$description": "The floating header capsule.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-radius-capsule"
        }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "column": {
      "$value": {
        "value": 1400,
        "unit": "px"
      },
      "$description": "Content column; matches the header capsule.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-column"
        }
      }
    },
    "gutter": {
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "Side gutter: 16px on a phone, 18px on a wide screen.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-gutter",
          "css_value": "clamp(16px, 1.4vw, 18px)"
        }
      }
    },
    "measure": {
      "$type": "number",
      "$value": 72,
      "$description": "Prose line length in characters.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-measure",
          "css_value": "72ch"
        }
      }
    }
  },
  "focus": {
    "color": {
      "$value": "{color.accent}",
      "$description": "Focus ring colour.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-focus"
        }
      },
      "$type": "color"
    },
    "width": {
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$description": "Focus ring width.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-focus-width"
        }
      },
      "$type": "dimension"
    },
    "offset": {
      "$value": {
        "value": 3,
        "unit": "px"
      },
      "$description": "Focus ring offset.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-focus-offset"
        }
      },
      "$type": "dimension"
    }
  },
  "shadow": {
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 12,
          "unit": "px"
        },
        "blur": {
          "value": 40,
          "unit": "px"
        },
        "spread": {
          "value": -20,
          "unit": "px"
        }
      },
      "$description": "Only floating layers: the header capsule and map overlays. Panels stay flat.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-shadow-overlay"
        }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        },
        "$description": "Hover and press.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-duration-fast"
          }
        }
      },
      "base": {
        "$value": {
          "value": 180,
          "unit": "ms"
        },
        "$description": "State changes and page transitions.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-duration-base"
          }
        }
      },
      "max": {
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$description": "Ceiling for any interface motion.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-duration-max"
          }
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0.7,
          0.2,
          1
        ],
        "$description": "The family curve.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-ease"
          }
        }
      }
    }
  },
  "state": {
    "$type": "color",
    "$description": "Evidence display states (docs/design/EVIDENCE-PRESENTATION-CONTRACT.md). Every state renders a mark and its literal word; colour is never the only channel.",
    "observed": {
      "$value": "{color.good}",
      "$description": "A reading from the named source.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-observed",
          "mark": "disc",
          "calm": true
        }
      }
    },
    "derived": {
      "$value": "{color.good}",
      "$description": "Computed by the product from observed inputs.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-derived",
          "mark": "diamond",
          "calm": true
        }
      }
    },
    "structural": {
      "$value": "{color.muted}",
      "$description": "Reference fact, not a reading.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-structural",
          "mark": "square",
          "calm": false
        }
      }
    },
    "research": {
      "$value": "{color.muted}",
      "$description": "Research output, not a verdict.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-research",
          "mark": "diamond-outline",
          "calm": false
        }
      }
    },
    "provisional": {
      "$value": "{color.warn}",
      "$description": "Separately dated provisional figure.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-provisional",
          "mark": "ring-dashed",
          "calm": false
        }
      }
    },
    "partial": {
      "$value": "{color.warn}",
      "$description": "Insufficient inputs or history. A gap.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-partial",
          "mark": "half",
          "calm": false
        }
      }
    },
    "stale": {
      "$value": "{color.warn}",
      "$description": "Older than its display limit.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-stale",
          "mark": "ring",
          "calm": false
        }
      }
    },
    "restricted": {
      "$value": "{color.warn}",
      "$description": "Withheld by rights or policy.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-restricted",
          "mark": "slash",
          "calm": false
        }
      }
    },
    "not-covered": {
      "$value": "{color.warn}",
      "$description": "Outside coverage. No value exists here.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-not-covered",
          "mark": "square-dotted",
          "calm": false
        }
      }
    },
    "unavailable": {
      "$value": "{color.bad}",
      "$description": "Source failed or returned nothing.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-state-unavailable",
          "mark": "hatch",
          "calm": false
        }
      }
    }
