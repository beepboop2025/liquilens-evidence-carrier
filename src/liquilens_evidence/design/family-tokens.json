{
  "$description": "LiquiLens research family tokens, record edition. One source for liquilens.in, Seiche and Undertow. Core colour and font values mirror the token block of research-ui/research.css; tests/test_design_tokens.py fails when they drift. Generated by scripts/build_design_tokens.py into CSS, Plotly, Matplotlib, Power BI and ANSI forms. Variable names are stable: add tokens, never rename.",
  "$extensions": {
    "in.liquilens": {
      "version": "1.0.0",
      "edition": "record",
      "source": "research-ui/research.css",
      "accent_rule": "one accent for every product; products differ by name and wordmark only"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      },
      "$description": "Page field.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-bg"
        }
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0431,
          0.051,
          0.0627
        ],
        "hex": "#0b0d10"
      },
      "$description": "Panels and consoles.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-surface"
        }
      }
    },
    "raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0784,
          0.0902,
          0.1098
        ],
        "hex": "#14171c"
      },
      "$description": "Selected rows and raised controls.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-raised"
        }
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1373,
          0.1529,
          0.1804
        ],
        "hex": "#23272e"
      },
      "$description": "Hairlines between rows and around panels.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-line"
        }
      }
    },
    "line-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3647,
          0.3882,
          0.4275
        ],
        "hex": "#5d636d"
      },
      "$description": "Form control borders. At least 3:1 against bg and surface (WCAG 1.4.11).",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-line-strong"
        }
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.9451,
          0.9255
        ],
        "hex": "#f2f1ec"
      },
      "$description": "Paper type and solid primary buttons.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-text"
        }
      }
    },
    "text-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.7059,
          0.7216,
          0.749
        ],
        "hex": "#b4b8bf"
      },
      "$description": "Long-form body copy on the field.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-text-secondary"
        }
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6157,
          0.6353,
          0.6706
        ],
        "hex": "#9da2ab"
      },
      "$description": "Labels, captions, source and date lines.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-muted"
        }
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6706,
          0.7804,
          1.0
        ],
        "hex": "#abc7ff"
      },
      "$description": "The one accent on every product: links, the lit state, focus.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-accent"
        }
      }
    },
    "good": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5725,
          0.8275,
          0.7412
        ],
        "hex": "#92d3bd"
      },
      "$description": "Data state only, always with words.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-good"
        }
      }
    },
    "warn": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9216,
          0.7725,
          0.5529
        ],
        "hex": "#ebc58d"
      },
      "$description": "Data state only, always with words.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-warn"
        }
      }
    },
    "bad": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9451,
          0.6392,
          0.6392
        ],
        "hex": "#f1a3a3"
      },
      "$description": "Data state only, always with words.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-bad"
        }
      }
    },
    "inverse": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      },
      "$description": "Ink on paper and accent fills.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-inverse"
        }
      }
    },
    "accent-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6706,
          0.7804,
          1.0
        ],
        "hex": "#abc7ff",
        "alpha": 0.1
      },
      "$description": "Selected row tint.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-accent-soft"
        }
      }
    },
    "warn-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9216,
          0.7725,
          0.5529
        ],
        "hex": "#ebc58d",
        "alpha": 0.08
      },
      "$description": "Tint behind a warn notice.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-warn-soft"
        }
      }
    },
    "bad-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9451,
          0.6392,
          0.6392
        ],
        "hex": "#f1a3a3",
        "alpha": 0.08
      },
      "$description": "Tint behind an unavailable notice and its hatch.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-bad-soft"
        }
      }
    },
    "overlay": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000",
        "alpha": 0.72
      },
      "$description": "Labels and controls drawn over imagery.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-overlay"
        }
      }
    },
    "reference": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4314,
          0.4627,
          0.5255
        ],
        "hex": "#6e7686"
      },
      "$description": "Reference series in charts, for example a long-run normal. 3:1 on surface.",
      "$extensions": {
        "in.liquilens": {
          "css": "--research-reference"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "text": {
        "$value": [
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI Variable Text",
          "Segoe UI",
          "Helvetica Neue",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "$description": "Everything a person reads. System stack; no web fonts.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-font"
          }
        }
      },
      "display": {
        "$value": [
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI Variable Display",
          "Segoe UI",
          "Helvetica Neue",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "$description": "Headings.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-display"
          }
        }
      },
      "code": {
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Cascadia Mono",
          "Roboto Mono",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Machine values: ids, figures in readouts, dates in source lines, JSON.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-code"
          }
        }
      }
    },
    "size": {
      "$type": "dimension",
      "label": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Labels, captions, source and date lines.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-size-label"
          }
        }
      },
      "small": {
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$description": "Table cells and secondary copy.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-size-small"
          }
        }
      },
      "body": {
        "$value": {
          "value": 15,
          "unit": "px"
        },
        "$description": "Body copy.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-size-body"
          }
        }
      },
      "lede": {
        "$value": {
          "value": 17,
          "unit": "px"
        },
        "$description": "Lede and panel titles.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-size-lede"
          }
        }
      },
      "section": {
        "$value": {
          "value": 21,
          "unit": "px"
        },
        "$description": "Section headings inside a page.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-size-section"
          }
        }
      },
      "figure": {
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "Headline figures in a readout.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-size-figure"
          }
        }
      },
      "page": {
        "$value": {
          "value": 52,
          "unit": "px"
        },
        "$description": "Page heading, fluid between 32px and 52px.",
        "$extensions": {
          "in.liquilens": {
            "css": "--research-size-page",
            "css_value": "clamp(32px, 3.6vw, 52px)",
            "min_px": 32
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$extensions": {
          "in.liquilens": {
            "css": "--research-weight-regular"
          }
        }
      },
      "medium": {
        "$value": 500,
        "$extensions": {
          "in.liquilens": {
            "css": "--research-weight-medium"
          }
        }
      },
      "semibold": {
        "$value": 600,
        "$extensions": {
          "in.liquilens": {
            "css": "--research-weight-semibold"
          }
        }
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.25,
        "$extensions": {
          "in.liquilens": {
            "css": "--research-leading-tight"
          }
        }
      },
      "body": {
        "$value": 1.65,
        "$extensions": {
          "in.liquilens": {
            "css": "--research-leading-body"
          }
        }
      }
    }
  },
